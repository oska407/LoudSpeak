<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 完全离线 App：不申请 INTERNET，模型由侧载（adb push / 文件拷贝）导入 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 模型扫描用：Android 11+ 默认读不到 /sdcard/Download，没这个权限就「明明放着却扫不到」。
         侧载场景可随时在系统设置里收回；没有它 App 也能用（只是扫不到 Download，
         需把模型拷到 App 目录或用 SAF 选目录）。 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".LoudSpeakApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LoudSpeak">

        <!-- B0/B1 验证期入口：主界面（含「系统自检」按钮）
             ⚠️ configChanges 必须声明：默认转屏会销毁重建 Activity，
             录到一半被人转一下手机，音频/已识别的整句/计时全部清零。
             自己处理旋转见 MainActivity.onConfigurationChanged。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- B0 内存自检页 -->
        <activity
            android:name=".SelfCheckActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <!-- B1 采集验证页（CameraX 预览 + 录制 + 实测分辨率）
             同上：录制中途转屏不能重建 -->
        <activity
            android:name=".CaptureVerifyActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density"
            android:screenOrientation="sensorLandscape" />

        <!-- 模式选择（§6.4 模式键） -->
        <activity
            android:name=".ModeSelectActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <!-- 设置页（分贝阈值 / 断句 / 红晕 / 模型） -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <!-- 历史列表（§11） -->
        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <!-- 历史「查看」（§R9：回看单条会话的音视频与标注文字） -->
        <activity
            android:name=".SessionViewActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <!-- 首次引导（§12.1） -->
        <activity
            android:name=".FirstRunActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <!-- 回收站（§11.4） -->
        <activity
            android:name=".TrashActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <!-- 错误报告（调试） -->
        <activity
            android:name=".ErrorsActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />
    </application>

</manifest>
