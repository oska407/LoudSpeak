<?xml version="1.0" encoding="utf-8"?>
<!-- 设置 · 模型与通道：本地 ASR + 网络模型通道 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="32dp">

        <TextView style="@style/SetSection" android:text="本地模型" />

        <LinearLayout style="@style/SetCard">

            <TextView
                android:id="@+id/tvModelStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.35"
                android:paddingTop="12dp"
                android:paddingBottom="6dp"
                android:textColor="@color/s_text"
                android:textSize="13sp" />

            <View style="@style/SetDivider" />

            <TextView
                style="@style/SetDesc"
                android:paddingTop="12dp"
                android:paddingBottom="6dp"
                android:text="下面几项是导入语音识别模型的方式，按需用。" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnScan"
                style="@style/SetBtn"
                android:text="扫描并安装 ASR 模型" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSaf"
                style="@style/SetBtn"
                android:text="从文件管理器选目录（会搜子目录）" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPick"
                style="@style/SetBtn"
                android:text="手动选择模型文件（.onnx + tokens.txt 一起选）" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCheck"
                style="@style/SetBtn"
                android:text="校验 ASR（真加载一次，约 15–30 秒）" />

            <TextView
                android:id="@+id/tvPerm"
                style="@style/SetDesc"
                android:paddingTop="10dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPerm"
                style="@style/SetBtn"
                android:text="授予「所有文件访问」权限（扫 Download 用）" />
        </LinearLayout>

        <TextView style="@style/SetSection" android:text="识别语言" />

        <LinearLayout style="@style/SetCard">
            <TextView
                style="@style/SetDesc"
                android:paddingTop="12dp"
                android:paddingBottom="6dp"
                android:text="「中文」只留中文句，说了英文会整句跳过（不显示乱码）；中英混说选「中英文」；「自动」识别成什么语种就留什么，完全不过滤。" />

            <RadioGroup
                android:id="@+id/rgLang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbLangZh"
                    style="@style/SetRadio"
                    android:text="中文" />

                <RadioButton
                    android:id="@+id/rbLangEn"
                    style="@style/SetRadio"
                    android:text="英文" />

                <RadioButton
                    android:id="@+id/rbLangAuto"
                    style="@style/SetRadio"
                    android:text="中英文" />

                <RadioButton
                    android:id="@+id/rbLangRaw"
                    style="@style/SetRadio"
                    android:text="自动" />
            </RadioGroup>
        </LinearLayout>

        <TextView style="@style/SetSection" android:text="网络通道" />

        <LinearLayout style="@style/SetCard">

            <TextView
                android:id="@+id/tvNetStatus"
                style="@style/SetDesc"
                android:paddingTop="12dp" />

            <RadioGroup
                android:id="@+id/rgNet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbNetAuto"
                    style="@style/SetRadio"
                    android:text="自动：PC 通就用 PC，不通就用本地" />

                <RadioButton
                    android:id="@+id/rbNetLocal"
                    style="@style/SetRadio"
                    android:text="只用本地（完全离线）" />

                <RadioButton
                    android:id="@+id/rbNetPc"
                    style="@style/SetRadio"
                    android:text="只用 PC（PC 没开就报错，不偷偷换）" />
            </RadioGroup>

            <View style="@style/SetDivider" />

            <LinearLayout style="@style/SetRow">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/SetTitle" android:text="PC 地址" />
                    <TextView
                        android:id="@+id/tvPcAddr"
                        style="@style/SetDesc" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnPcIp"
                    style="@style/SetBtn"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="0dp"
                    android:text="改 IP" />
            </LinearLayout>

            <View style="@style/SetDivider" />

            <LinearLayout style="@style/SetRow">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/SetTitle" android:text="用家里 PC 的大模型判定" />
                    <TextView
                        style="@style/SetDesc"
                        android:text="关着的时候，判定在手机上离线做完，录音和文字都不出手机。&#10;打开后，每次判定会把「这次的句子文字」发给上面的 PC，PC 上的大模型判完回结果；PC 没开、断了、超时，都自动退回手机本地规则，不会卡住也不会报错。" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swPcJudge"
                    style="@style/SetSwitch" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPcJudgeTest"
                style="@style/SetBtn"
                android:layout_marginTop="0dp"
                android:text="测试 PC 判定（发两句样例试试）" />

            <TextView
                style="@style/SetDesc"
                android:paddingTop="8dp"
                android:text="⚠ 只有这一项会把数据发到局域网里的 PC（只发本次句子文字，不发录音）。想要「数据绝不出手机」，把开关关掉即可，关掉后 App 一次网络请求都不会发。" />
        </LinearLayout>

        <TextView style="@style/SetSection" android:text="其它" />

        <LinearLayout style="@style/SetCard">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSelf"
                style="@style/SetBtn"
                android:layout_marginTop="12dp"
                android:text="系统自检（内存 / 存储 / 麦克风）" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCapture"
                style="@style/SetBtn"
                android:text="采集验证（预览 / 录制 / 实测分辨率）" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnErr"
                style="@style/SetBtn"
                android:text="错误报告（调试用）" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
