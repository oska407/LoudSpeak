<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- 左栏：摄像头预览 / 回放视频（①③ 档；②④ 档隐藏，右栏占满） -->
        <FrameLayout
            android:id="@+id/leftPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="26"
            android:background="#000000">

            <!-- 取景窗口：内层比外框宽 16:9，左右平移挑一段竖条显示。
                 人脸位置由 MainActivity 的肤色质心标定 / 手动拖动决定（见 FramingWindow）。 -->
            <com.oska.loudspeak.FramingWindow
                android:id="@+id/previewBox"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.camera.view.PreviewView
                    android:id="@+id/previewView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <VideoView
                    android:id="@+id/videoView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
            </com.oska.loudspeak.FramingWindow>

            <!-- 角标放在取景窗口外面，不参与平移 -->
            <TextView
                android:id="@+id/tvModeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="#99000000"
                android:padding="4dp"
                android:text="③ 纯显示·带画面"
                android:textColor="#FF4ADE80"
                android:textSize="13sp" />

            <!-- 视频窗口范围的红晕（R11）：只在这块四周泛红，右栏文字区一点不受影响。
                 跟全屏那层一样，只在 dispatchDraw 里画、不挂监听、不拦触摸。 -->
            <view
                class="com.oska.loudspeak.MainActivity$GlowHost"
                android:id="@+id/glowVideo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="false"
                android:focusable="false" />
        </FrameLayout>

        <!-- 分隔线 -->
        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="#FF22303A" />

        <!-- 右栏：四行 152/128/306/134 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="73"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="3dp">

            <!-- 第 1 行 数据区。⚠️ 行高权重 152（原 142）：真机上卡片底部数字仍被裁掉一点，
                 2026-10-23 从按钮行(144→134)匀了 8 份过来，配合 DataCard padding 6→3dp -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="152"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- 卡片名一律两字（时长/整句/代词）——四字标签在 elevate 行高下会顶破卡片被裁掉 -->
                <LinearLayout style="@style/DataCard" android:layout_weight="1">
                    <TextView style="@style/CardLabel" android:text="时长" />
                    <TextView style="@style/CardValue" android:id="@+id/tvDuration" android:text="00:00" />
                </LinearLayout>
                <LinearLayout style="@style/DataCard" android:layout_weight="1">
                    <TextView style="@style/CardLabel" android:text="整句" />
                    <TextView style="@style/CardValue" android:id="@+id/tvSentCount" android:text="0" />
                </LinearLayout>
                <LinearLayout style="@style/DataCard" android:layout_weight="1">
                    <TextView style="@style/CardLabel" android:text="代词" />
                    <TextView style="@style/CardValue" android:id="@+id/tvPronCount" android:text="0" />
                </LinearLayout>

                <!-- 分贝卡：主视觉（约 1.9 倍宽），自绘 LCD -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.9"
                    android:layout_margin="4dp">
                    <view
                        class="com.oska.loudspeak.MainActivity$LcdHost"
                        android:id="@+id/lcdView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>
            </LinearLayout>

            <!-- 第 2 行 波形 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="128"
                android:layout_marginTop="4dp">
                <view
                    class="com.oska.loudspeak.MainActivity$WaveHost"
                    android:id="@+id/waveView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <!-- 第 3 行 识别文字（书写式：格线 + 自动跟随 / 手动拖动 / 阻尼回收焦点）
                 字号 22sp → 18sp（小两号），由 WritingTextArea 内部设定 -->
            <com.oska.loudspeak.WritingTextArea
                android:id="@+id/textArea"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="348"
                android:layout_marginTop="4dp"
                android:background="@color/card_bg"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbarStyle="outsideOverlay" />

            <!-- 第 4 行 七键两组：停止/暂停/录音/播放 + 列表/设置/模式
                 七键等分（layout_weight=1，见 @style/Btn）：任何屏幕宽度都不会被挤出屏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="100"
                android:layout_marginTop="2dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button android:id="@+id/btnStop" style="@style/Btn" android:enabled="false" android:text="停止" />
                <Button android:id="@+id/btnPause" style="@style/Btn" android:enabled="false" android:text="暂停" />
                <Button android:id="@+id/btnRec" style="@style/Btn" android:layout_weight="1.3" android:text="录音" />
                <Button android:id="@+id/btnPlay" style="@style/Btn" android:enabled="false" android:text="播放" />

                <!-- 组间距（不参与等分） -->
                <View
                    android:layout_width="3dp"
                    android:layout_height="1dp" />

                <Button android:id="@+id/btnHistory" style="@style/Btn" android:text="列表" />
                <Button android:id="@+id/btnSettings" style="@style/Btn" android:text="设置" />
                <Button android:id="@+id/btnMode" style="@style/Btn" android:text="模式" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 红晕：全屏边缘泛红，不拦截触控 -->
    <view
        class="com.oska.loudspeak.MainActivity$GlowHost"
        android:id="@+id/glowView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 回放跳过（右下角，醒目） -->
    <Button
        android:id="@+id/btnSkipReplay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:backgroundTint="#FFFFD54F"
        android:text="跳过 ▶▶"
        android:textColor="#FF000000"
        android:visibility="gone" />

    <!-- 追问卡（录后诊断，底部浮层） -->
    <ScrollView
        android:id="@+id/diagnosisPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="8dp"
        android:background="#EE1C242B"
        android:elevation="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvDiagnosisTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="诊断"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/diagnosisList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRetake"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="再讲一次这道题"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/btnCloseDiagnosis"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="关闭"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
