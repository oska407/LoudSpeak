<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="DataCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@color/card_bg</item>
    </style>
    <style name="CardLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="CardValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <!-- 底部七键：等分占满一行（不设 minWidth，否则 7×92dp 会把「设置/模式」挤出屏幕）；
         颜色全部显式指定 —— 主题是 Material3 DayNight，本机浅色模式下 disabled 按钮
         用的是近黑 onSurface，画在深色背景上等于隐形（真机实测看不到「停止/暂停/播放」）。 -->
    <style name="Btn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">2dp</item>
        <item name="android:paddingRight">2dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/btn_text</item>
        <item name="android:backgroundTint">@color/btn_bg</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

</resources>
